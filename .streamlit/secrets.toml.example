# Template for .streamlit/secrets.toml (local) or the "Secrets" box in Streamlit Community Cloud.
# Copy, fill in your own key, and NEVER commit the real file.

GEMINI_API_KEY = "paste-your-gemini-key-here"     # from https://aistudio.google.com/apikey
# OPENAI_API_KEY = "sk-..."                       # only if provider = "openai"

[ai]
enabled = true
provider = "gemini"

# Who may trigger paid AI calls:
#   "local"     - only requests to localhost (your own computer)
#   "public"    - any visitor, limited by the rate limits below (use for an open demo)
#   "allowlist" - only signed-in users listed in allowed_emails (needs [auth] / st.login)
access = "public"

# Rate limits (server-side; reloading the page does not reset them)
max_calls_per_user_hour = 3     # per visitor
max_calls_per_user_day = 6
cooldown_seconds = 30
max_calls_per_hour = 10         # whole site, all visitors combined
max_calls_per_day = 30
max_calls_per_session = 3

[demo]
autoload = true                 # auto-load data/ sample if present (not in the public repo)
